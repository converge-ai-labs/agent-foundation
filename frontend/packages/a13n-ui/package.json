{
  "name": "a13n-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./vite": "./vite.ts",
    "./display": "./src/lib/display.ts",
    "./styles.css": "./src/styles/index.css",
    "./theme.css": "./src/styles/theme.css",
