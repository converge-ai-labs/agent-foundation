{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "existingSecret", "publicUrl", "roles", "objects"],
  "definitions": {
    "secretKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "key"],
      "properties": {
        "name": { "type": "string" },
        "key": { "type": "string", "minLength": 1 }
      }
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[0-9a-f]{64}$"
        },
        "pullPolicy": {
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      },
      "additionalProperties": false
    },
    "role": {
      "type": "object",
      "required": ["replicaCount"],
      "additionalProperties": false,
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object"
        },
        "autoscaling": {
          "type": "object",
          "required": [
            "enabled",
            "minReplicas",
            "maxReplicas",
            "targetCPUUtilizationPercentage"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "targetCPUUtilizationPercentage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        }
      }
    }
  },
  "properties": {
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vmagent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "image": { "$ref": "#/definitions/image" },
            "prometheusUrl": {
              "type": "string",
              "pattern": "^$|^https?://[^/?#@,\\s]+(/[^?#,\\s]*)?$"
            },
            "remoteWriteUrl": {
              "type": "string",
              "pattern": "^$|^https?://[^/?#@,\\s]+(/[^?#,\\s]*)?$"
            },
            "remoteWriteBearerTokenSecret": {
              "$ref": "#/definitions/secretKey"
            },
            "remoteWriteCASecret": { "$ref": "#/definitions/secretKey" },
            "maxDiskUsage": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(MB|GB|TB|MiB|GiB|TiB)$"
            },
            "resources": { "type": "object" },
            "writerResources": { "type": "object" },
            "persistence": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "existingClaim": { "type": "string" },
                "storageClassName": { "type": ["string", "null"] },
                "size": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "deploymentPreset": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "name": { "type": "string", "minLength": 1, "maxLength": 128 },
            "collector": { "enum": ["vmagent", "alloy"] },
            "queryEndpoint": {
              "type": "string",
              "pattern": "^$|^https?://[^/?#@,\\s]+(/[^?#,\\s]*)?$"
            },
            "workspaceIds": {
              "type": "array",
              "maxItems": 1024,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "queryBearerTokenSecret": { "$ref": "#/definitions/secretKey" }
          }
        }
      }
    },
    "image": {
      "$ref": "#/definitions/image"
    },
    "existingSecret": {
      "type": "string",
      "minLength": 1
    },
    "publicUrl": {
      "type": "string",
      "pattern": "^https?://"
    },
    "trustedProxies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "serviceAccount": {
      "type": "object",
      "required": ["create", "name", "annotations"],
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "if": {
        "properties": {
          "create": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "name": {
            "minLength": 1
          },
          "annotations": {
            "maxProperties": 0
          }
        }
      }
    },
    "extraConfig": {
      "type": "string"
    },
    "roles": {
      "type": "object",
      "required": ["control", "worker"],
      "additionalProperties": false,
      "properties": {
        "control": {
          "$ref": "#/definitions/role"
        },
        "worker": {
          "$ref": "#/definitions/role"
        }
      }
    },
    "objects": {
      "type": "object",
      "required": ["backend"],
      "additionalProperties": false,
      "properties": {
        "backend": {
          "enum": ["local", "s3"]
        },
        "bucket": {
          "type": "string"
        },
        "prefix": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "endpointUrl": {
          "type": "string"
        },
        "addressingStyle": {
          "enum": ["", "auto", "path", "virtual"]
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": ["enabled", "port"],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "not": {
            "const": 8000
          }
        },
        "podMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string",
              "pattern": "^[0-9]+(ms|s|m|h)$"
            },
            "labels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["ClusterIP", "NodePort"]
        },
        "nodePort": {
          "type": "integer",
          "minimum": 30000,
          "maximum": 32767
        },
        "annotations": {
          "type": "object"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^$|^[A-Za-z0-9]([A-Za-z0-9_.-]*[A-Za-z0-9])?$"
          }
        }
      }
    }
  }
}
