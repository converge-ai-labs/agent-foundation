# Copy outside the repository and chmod 600. Do not source this file in a shell.
# Supply it to kubectl create secret --from-env-file; never commit filled values.
# Passwords inside URLs must be URL-encoded. Use rediss:// when Redis provides TLS.
A13N_DATABASE__URL=postgresql+psycopg://REPLACE_USER:REPLACE_URL_ENCODED_PASSWORD@REPLACE_PG_HOST:5432/REPLACE_DATABASE
A13N_REDIS__URL=redis://REPLACE_USER:REPLACE_URL_ENCODED_PASSWORD@REPLACE_REDIS_HOST:6379/0
# Generate a 32-byte base64 key locally and preserve the key ring across upgrades.
A13N_ENCRYPTION__ACTIVE_KEY_ID=primary
A13N_ENCRYPTION__KEYS={"primary":"REPLACE_BASE64_32_BYTE_KEY"}
# S3 credentials only; omit when using a shared filesystem or a supported workload identity.
A13N_OBJECTS__ACCESS_KEY_ID=REPLACE_ACCESS_KEY_ID
A13N_OBJECTS__SECRET_ACCESS_KEY=REPLACE_SECRET_ACCESS_KEY
A13N_OBJECTS__PATH_STYLE=false
# For providers such as OSS that reject optional streaming checksum trailers:
# AWS_REQUEST_CHECKSUM_CALCULATION=when_required
# These settings are covered by the example's 300-second Pod termination budget.
A13N_SERVER__SHUTDOWN_TIMEOUT=120
A13N_WORKER__DRAIN_SECONDS=90
