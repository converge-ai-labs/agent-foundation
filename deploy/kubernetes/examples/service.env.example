# Copy outside the repository, chmod 600, replace placeholders, then create a Secret.
# Every key is a Service setting (A13N_<SECTION>__<FIELD>); unknown A13N_ keys stop startup.
# Use URL-encoded passwords in connection URLs. Local release name here is "a13n".
A13N_DATABASE__URL=postgresql+psycopg://a13n_service:REPLACE_PASSWORD@a13n-a13n-postgres:5432/a13n_service
# Generate a key with: openssl rand -base64 32. Keep retired keys in the ring to read older credentials.
A13N_ENCRYPTION__ACTIVE_KEY_ID=primary
A13N_ENCRYPTION__KEYS={"primary":"REPLACE_BASE64_32_BYTE_KEY"}
# Without bundled Redis, supply a protected non-cluster endpoint.
# A13N_REDIS__URL=rediss://:REPLACE_PASSWORD@REPLACE_REDIS_HOST:6379/0
# With objects.backend s3, the bucket's credentials unless the Pod's identity provides them.
# A13N_OBJECTS__ACCESS_KEY_ID=REPLACE_S3_ACCESS_KEY
# A13N_OBJECTS__SECRET_ACCESS_KEY=REPLACE_S3_SECRET_KEY
