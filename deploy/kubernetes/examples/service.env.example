# Copy outside the repository, chmod 600, replace placeholders, then create a Secret.
# Use URL-encoded passwords in connection URLs. Local release name here is "a13n".
A13N_SERVICE_DATABASE_URL=postgresql+psycopg://a13n_service:REPLACE_PASSWORD@a13n-a13n-postgres:5432/a13n_service
A13N_SERVICE_IAM_INITIAL_ADMIN_EMAIL=admin@example.com
# Generate with: openssl rand -base64 32
A13N_SERVICE_SECRET_MASTER_KEY_BASE64=REPLACE_BASE64_32_BYTE_KEY
A13N_SERVICE_SECRET_ENCRYPTION_KEY_ID=primary-v1
# Distributed deployments require a real Redis URL (choose a non-cluster endpoint).
# A13N_SERVICE_REDIS_URL=rediss://:REPLACE_PASSWORD@REPLACE_REDIS_HOST:6379/0
# AWS: prefer Pod Identity / IRSA instead of long-lived AWS keys.
# GCP with an external S3 endpoint: provide its credentials, NOT GCP OAuth tokens.
# AWS_ACCESS_KEY_ID=REPLACE_S3_ACCESS_KEY
# AWS_SECRET_ACCESS_KEY=REPLACE_S3_SECRET_KEY
