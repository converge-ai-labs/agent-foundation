worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 1024; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp;
    fastcgi_temp_path /tmp/fastcgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;
    scgi_temp_path /tmp/scgi_temp;
    # Exclude query strings, which can contain one-time authorization material.
    log_format safe '$remote_addr $request_method $uri $status';
    access_log /dev/stdout safe;
    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }
    map $http_x_forwarded_proto $forwarded_proto {
        default $scheme;
        https https;
    }
    server {
        listen 8080;
        root /usr/share/nginx/html;
        index index.html;
        client_max_body_size 128m;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        location = /healthz { access_log off; return 200 'ok\n'; }
        location ~ ^/connectivity(/|$) {
            proxy_pass ${A13N_CONNECTIVITY_UPSTREAM};
        }
        location ~ ^/(api|a2a|ag-ui|connection-authorizations)(/|$)|^/\.well-known/|^/readyz$ {
            proxy_pass ${A13N_CONTROL_UPSTREAM};
        }
        location /assets/ { try_files $uri =404; }
        location = /index.html { add_header Cache-Control "no-store"; }
        location / { try_files $uri /index.html; }
    }
}
