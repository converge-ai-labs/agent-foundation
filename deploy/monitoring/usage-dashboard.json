    {
      "id": 12,
      "type": "barchart",
      "title": "Daily tokens",
      "description": "UTC date categories retain partial-day selections. Cached input is already included in input tokens; do not add it again.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT to_char(u.ingested_at AT TIME ZONE 'UTC','YYYY-MM-DD') AS day, coalesce(sum((u.record->'request_usage'->>'input_tokens')::bigint), 0) AS input_tokens, coalesce(sum((u.record->'request_usage'->>'output_tokens')::bigint), 0) AS output_tokens FROM usage_records u WHERE u.record->>'kind' = 'model' AND u.ingested_at >= to_timestamp(${__from} / 1000.0) AND u.ingested_at < to_timestamp(${__to} / 1000.0) AND u.organization_id IN (${organization:sqlstring}) AND u.workspace_id IN (${workspace:sqlstring}) GROUP BY 1 ORDER BY 1",
          "format": "table",
