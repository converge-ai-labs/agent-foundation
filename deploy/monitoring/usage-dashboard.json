    {
      "id": 15,
      "type": "table",
      "title": "Model usage by workspace and model",
      "description": "Top 100 current model contributions; IDs prevent cross-tenant name collisions. Known cost excludes unpriced requests. Cache rate is ratio of totals.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 49,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT o.id AS organization_id, o.name AS organization, w.id AS workspace_id, w.name AS workspace, coalesce(m.id,'unattributed') AS model_id, coalesce(m.key,'unattributed') AS model, count(*) AS requests, coalesce(sum((u.record->'request_usage'->>'input_tokens')::bigint), 0) AS input_tokens, coalesce(sum((u.record->'request_usage'->>'output_tokens')::bigint), 0) AS output_tokens, coalesce(sum((u.record->'request_usage'->>'cache_read_tokens')::bigint), 0) AS cached_input_tokens, CASE WHEN count(*) = 0 THEN 0 ELSE sum((u.record->'request_usage'->>'cost')::numeric) END AS known_cost_usd, count(*) FILTER (WHERE (u.record->'request_usage'->>'cost')::numeric IS NULL) AS unpriced_requests, coalesce(sum((u.record->'request_usage'->>'cache_read_tokens')::bigint), 0)::numeric / nullif(coalesce(sum((u.record->'request_usage'->>'input_tokens')::bigint), 0),0) AS cache_hit_rate FROM usage_records u JOIN workspaces w ON w.id=u.workspace_id JOIN organizations o ON o.id=u.organization_id LEFT JOIN models m ON m.id=u.model_id WHERE u.record->>'kind' = 'model' AND u.ingested_at >= to_timestamp(${__from} / 1000.0) AND u.ingested_at < to_timestamp(${__to} / 1000.0) AND u.organization_id IN (${organization:sqlstring}) AND u.workspace_id IN (${workspace:sqlstring}) GROUP BY o.id,o.name,w.id,w.name,m.id,m.key ORDER BY requests DESC,o.id,w.id,m.id LIMIT 100",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
