              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "graphMode": "none",
        "colorMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Started runs",
      "description": "Runs selected independently by started_at, including ongoing Runs. Waiting seals; resumed successors count separately.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 6,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT count(*) AS runs FROM runs r WHERE r.started_at >= to_timestamp(${__from} / 1000.0) AND r.started_at < to_timestamp(${__to} / 1000.0) AND r.organization_id IN (${organization:sqlstring}) AND r.workspace_id IN (${workspace:sqlstring})",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Unavailable",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "runs"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Runs"
              },
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "graphMode": "none",
        "colorMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Average sealed runtime",
      "description": "Started Run cohort, average over sealed members only. Includes recovery waits; not only model execution.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 6,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT avg(extract(epoch FROM r.sealed_at-r.started_at)) AS average_duration_seconds FROM runs r WHERE r.started_at >= to_timestamp(${__from} / 1000.0) AND r.started_at < to_timestamp(${__to} / 1000.0) AND r.organization_id IN (${organization:sqlstring}) AND r.workspace_id IN (${workspace:sqlstring})",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Unavailable",
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "average_duration_seconds"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Average runtime"
              },
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "graphMode": "none",
        "colorMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Trends \u2014 consumption follows first ingestion, Runs follow first start",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Daily model usage",
      "description": "Daily UTC facts. Late contribution replacements revise earlier ingestion buckets. Missing days have no observations, not synthetic zeroes.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT date_trunc('day',u.ingested_at AT TIME ZONE 'UTC') AT TIME ZONE 'UTC' AS time, count(*) AS requests, coalesce(sum((u.record->'request_usage'->>'input_tokens')::bigint), 0) AS input_tokens, coalesce(sum((u.record->'request_usage'->>'output_tokens')::bigint), 0) AS output_tokens, coalesce(sum((u.record->'request_usage'->>'cache_read_tokens')::bigint), 0) AS cached_input_tokens, CASE WHEN count(*) = 0 THEN 0 ELSE sum((u.record->'request_usage'->>'cost')::numeric) END AS known_cost_usd, count(*) FILTER (WHERE (u.record->'request_usage'->>'cost')::numeric IS NULL) AS unpriced_requests FROM usage_records u WHERE u.record->>'kind' = 'model' AND u.ingested_at >= to_timestamp(${__from} / 1000.0) AND u.ingested_at < to_timestamp(${__to} / 1000.0) AND u.organization_id IN (${organization:sqlstring}) AND u.workspace_id IN (${workspace:sqlstring}) GROUP BY 1 ORDER BY 1",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Unavailable",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "known_cost_usd"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Known cost (USD)"
              },
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 6
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "unpriced_requests"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Unpriced requests"
              },
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "input_tokens"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Input tokens"
              },
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "output_tokens"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Output tokens"
              },
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cached_input_tokens"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Cached input tokens"
              },
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "time"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Day (UTC)"
              },
              {
                "id": "unit",
                "value": "time:YYYY-MM-DD"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "day"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Day (UTC)"
              },
              {
                "id": "unit",
                "value": "string"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "requests"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Requests"
              },
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Daily started runs",
      "description": "UTC start cohort and current statuses. Not a time series of seal events. Pending never-started Runs are excluded.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT date_trunc('day',r.started_at AT TIME ZONE 'UTC') AT TIME ZONE 'UTC' AS time, r.status, count(*) AS runs FROM runs r WHERE r.started_at >= to_timestamp(${__from} / 1000.0) AND r.started_at < to_timestamp(${__to} / 1000.0) AND r.organization_id IN (${organization:sqlstring}) AND r.workspace_id IN (${workspace:sqlstring}) GROUP BY 1,2 ORDER BY 1,2",
          "format": "table",
