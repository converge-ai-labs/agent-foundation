{
  "uid": "a13n-service-usage",
  "title": "a13n Service usage",
  "description": "Optional operator-only PostgreSQL dashboard. Selectors are analysis filters, NOT Service tenant authorization. Read-only credential can read all granted rows. UTC, [from,to), first-ingested model contributions and independently started Runs. Custom copies are user-owned.",
  "tags": [
    "a13n",
    "usage"
  ],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "timezone": "utc",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "PostgreSQL",
        "type": "datasource",
        "query": "grafana-postgresql-datasource"
      },
      {
        "name": "organization",
        "label": "Organization",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${datasource}"
        },
        "query": "SELECT name || ' [' || id || ']' AS __text, id AS __value FROM organizations ORDER BY name,id",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "workspace",
        "label": "Workspace",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${datasource}"
        },
        "query": "SELECT name || ' [' || id || ']' AS __text, id AS __value FROM workspaces WHERE organization_id IN (${organization:sqlstring}) ORDER BY name,id",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Usage overview \u2014 durable facts, UTC, half-open selected window",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Known recorded cost",
      "description": "Known USD subtotal only; compare pricing completeness. All unknown prices \u2192 unavailable; zero requests \u2192 0. Never reprices history.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT CASE WHEN count(*) = 0 THEN 0 ELSE sum((u.record->'request_usage'->>'cost')::numeric) END AS known_cost_usd FROM usage_records u WHERE u.record->>'kind' = 'model' AND u.ingested_at >= to_timestamp(${__from} / 1000.0) AND u.ingested_at < to_timestamp(${__to} / 1000.0) AND u.organization_id IN (${organization:sqlstring}) AND u.workspace_id IN (${workspace:sqlstring})",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "noValue": "Unavailable",
          "decimals": 6
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "known_cost_usd"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Known cost (USD)"
              },
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 6
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "graphMode": "none",
        "colorMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Unpriced requests",
      "description": "Model contributions without a recorded price. A zero-priced known request is priced, not unknown.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT count(*) FILTER (WHERE (u.record->'request_usage'->>'cost')::numeric IS NULL) AS unpriced_requests FROM usage_records u WHERE u.record->>'kind' = 'model' AND u.ingested_at >= to_timestamp(${__from} / 1000.0) AND u.ingested_at < to_timestamp(${__to} / 1000.0) AND u.organization_id IN (${organization:sqlstring}) AND u.workspace_id IN (${workspace:sqlstring})",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Unavailable",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "unpriced_requests"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Unpriced requests"
              },
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "graphMode": "none",
        "colorMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Pricing coverage",
      "description": "Share of requests with known prices, not share of token or spend coverage. No requests \u2192 unavailable.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT count((u.record->'request_usage'->>'cost')::numeric)::numeric / nullif(count(*),0) AS pricing_coverage FROM usage_records u WHERE u.record->>'kind' = 'model' AND u.ingested_at >= to_timestamp(${__from} / 1000.0) AND u.ingested_at < to_timestamp(${__to} / 1000.0) AND u.organization_id IN (${organization:sqlstring}) AND u.workspace_id IN (${workspace:sqlstring})",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Unavailable",
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "pricing_coverage"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Pricing coverage"
              },
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "graphMode": "none",
        "colorMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Model requests",
      "description": "Current model contributions selected by first ingested_at. Replacement reports revise this original time bucket; not raw event count.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT count(*) AS requests FROM usage_records u WHERE u.record->>'kind' = 'model' AND u.ingested_at >= to_timestamp(${__from} / 1000.0) AND u.ingested_at < to_timestamp(${__to} / 1000.0) AND u.organization_id IN (${organization:sqlstring}) AND u.workspace_id IN (${workspace:sqlstring})",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
