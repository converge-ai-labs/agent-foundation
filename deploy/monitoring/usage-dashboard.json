          "rawSql": "SELECT o.id AS organization_id, o.name AS organization, w.id AS workspace_id, w.name AS workspace, count(*) AS runs, count(*) FILTER (WHERE r.status='failed') AS failed, count(*) FILTER (WHERE r.status='waiting') AS waiting, avg(extract(epoch FROM r.sealed_at-r.started_at)) AS average_duration_seconds FROM runs r JOIN workspaces w ON w.id=r.workspace_id JOIN organizations o ON o.id=r.organization_id WHERE r.started_at >= to_timestamp(${__from} / 1000.0) AND r.started_at < to_timestamp(${__to} / 1000.0) AND r.organization_id IN (${organization:sqlstring}) AND r.workspace_id IN (${workspace:sqlstring}) GROUP BY o.id,o.name,w.id,w.name ORDER BY runs DESC,o.id,w.id LIMIT 100",
