{
  "uid": "a13n-service-operations",
  "title": "a13n Service operations",
  "description": "Health, runs, execution and background work of a13n Service, from its Prometheus metrics.",
  "tags": [
    "a13n"
  ],
  "editable": true,
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Requests",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "type": "stat",
      "title": "Targets up",
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=\"a13n-service\"})"
        }
      ]
    },
    {
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "type": "stat",
      "title": "5xx ratio (5m)",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"a13n-service\", http_response_status_code=~\"5..\"}[5m])) / sum(rate(http_server_request_duration_seconds_count{job=\"a13n-service\"}[5m]))"
        }
      ]
    },
    {
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "type": "timeseries",
      "title": "Requests by status",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{job=\"a13n-service\"}[$__rate_interval]))",
          "legendFormat": "{{http_response_status_code}}"
        }
      ]
    },
    {
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "type": "timeseries",
      "title": "Request duration p95 by route",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(http_server_request_duration_seconds_bucket{job=\"a13n-service\"}[$__rate_interval])))",
          "legendFormat": "{{http_route}}"
        }
      ],
      "description": "Streaming routes last as long as their stream."
    },
    {
      "type": "row",
      "title": "Runs",
      "id": 6,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": []
    },
    {
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "type": "timeseries",
      "title": "Accepted runs by trigger",
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * sum by (trigger) (rate(a13n_runs_accepted_total{job=\"a13n-service\"}[$__rate_interval]))",
          "legendFormat": "{{trigger}}"
        }
      ]
    },
    {
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "type": "timeseries",
      "title": "Sealed runs by status",
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * sum by (status) (rate(a13n_runs_sealed_total{job=\"a13n-service\"}[$__rate_interval]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "type": "timeseries",
      "title": "Failed and cancelled runs by reason",
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * sum by (reason) (rate(a13n_runs_sealed_total{job=\"a13n-service\", reason!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Execution",
      "id": 10,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "panels": []
    },
    {
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "type": "timeseries",
      "title": "Queue wait before a claim",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(a13n_attempt_queue_wait_seconds_bucket{job=\"a13n-service\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(a13n_attempt_queue_wait_seconds_bucket{job=\"a13n-service\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 35
      },
      "type": "timeseries",
      "title": "Attempt duration p95 by status",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, status) (rate(a13n_attempt_duration_seconds_bucket{job=\"a13n-service\"}[$__rate_interval])))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 43
      },
      "type": "timeseries",
      "title": "Worker slots",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state) (a13n_worker_slots{job=\"a13n-service\"})",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 14,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 43
      },
      "type": "timeseries",
      "title": "Model tokens by type",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * sum by (gen_ai_token_type) (rate(gen_ai_client_token_usage_sum{job=\"a13n-service\"}[$__rate_interval]))",
          "legendFormat": "{{gen_ai_token_type}}"
        }
      ],
      "description": "Tokens per minute, as Pydantic AI reports them. Usage records in PostgreSQL are the authoritative counts."
    },
    {
      "type": "row",
      "title": "Backlog and background work",
      "id": 15,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 51
      },
      "panels": []
    },
    {
      "id": 16,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 52
      },
      "type": "timeseries",
      "title": "Due work by queue",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (queue) (a13n_backlog_size{job=\"a13n-service\"})",
          "legendFormat": "{{queue}}"
        }
      ],
      "description": "Every control replica reports the same count; the panel takes the maximum."
    },
    {
      "id": 17,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 52
      },
      "type": "timeseries",
      "title": "Oldest due item by queue",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (queue) (a13n_backlog_oldest_age_seconds{job=\"a13n-service\"})",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 18,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 60
      },
      "type": "timeseries",
      "title": "Outbox deliveries by kind and result",
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * sum by (kind, result) (rate(a13n_outbox_deliveries_total{job=\"a13n-service\"}[$__rate_interval]))",
          "legendFormat": "{{kind}} {{result}}"
        }
      ]
    },
    {
      "id": 19,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 60
      },
      "type": "timeseries",
      "title": "Failed sweep passes",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (sweep) (increase(a13n_sweep_passes_total{job=\"a13n-service\", result=\"failed\"}[$__rate_interval]))",
          "legendFormat": "{{sweep}}"
        }
      ]
    }
  ]
}
