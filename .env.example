A13N_SERVICE_ROLE=all
A13N_SERVICE_HOST=127.0.0.1
A13N_SERVICE_PORT=8000
A13N_SERVICE_CONNECTIVITY_PUBLIC_ORIGIN=http://127.0.0.1:8000
A13N_SERVICE_CONNECTIVITY_HTTP_ORIGINS='["http://127.0.0.1:8000"]'
# A13N_SERVICE_CONNECTIVITY_PROVIDER_ORIGINS='["https://hooks.example.com"]'
A13N_SERVICE_CONNECTIVITY_PROVIDER_REQUEST_MAX_BYTES=1048576
A13N_SERVICE_CONNECTIVITY_PROTECTED_RAW_RETENTION_SECONDS=0
A13N_SERVICE_CONNECTIVITY_DEDUP_HORIZON_SECONDS=604800
A13N_SERVICE_CONNECTIVITY_CATALOG_RETENTION_SECONDS=2592000
A13N_SERVICE_CONNECTIVITY_RETENTION_POLL_INTERVAL_SECONDS=60
A13N_SERVICE_CONNECTIVITY_RETENTION_LEASE_SECONDS=60
A13N_SERVICE_CONNECTIVITY_OBJECT_CLEANUP_GRACE_SECONDS=3600
A13N_SERVICE_CONNECTIVITY_RETENTION_BATCH_SIZE=25
A13N_SERVICE_DATABASE_BACKEND=postgresql
A13N_SERVICE_DATABASE_URL=postgresql+psycopg://a13n_service:a13n_service@127.0.0.1:5432/a13n_service
A13N_SERVICE_DATABASE_SQLITE_PATH=var/a13n-service.sqlite3
A13N_SERVICE_REDIS_BACKEND=redis
A13N_SERVICE_REDIS_URL=redis://127.0.0.1:6379/0
A13N_SERVICE_OBJECT_BACKEND=local
A13N_SERVICE_OBJECT_LOCAL_ROOT=var/objects
# A13N_SERVICE_OBJECT_BUCKET=a13n-service-objects
# A13N_SERVICE_OBJECT_REGION=us-east-1
# A13N_SERVICE_OBJECT_ENDPOINT_URL=http://127.0.0.1:9000
# A13N_SERVICE_OBJECT_FORCE_PATH_STYLE=true
A13N_SERVICE_FILESYSTEM_ROOT=var/files
# Control, connectivity, and all roles require a deployment-managed 32-byte key.
# A13N_SERVICE_SECRET_MASTER_KEY_BASE64=<standard-base64-encoded-32-byte-key>
# A13N_SERVICE_SECRET_ENCRYPTION_KEY_ID=master-2026-09
A13N_SERVICE_DATABASE_CONNECT_TIMEOUT_SECONDS=10
A13N_SERVICE_DATABASE_STATEMENT_TIMEOUT_SECONDS=30
A13N_SERVICE_DATABASE_READINESS_TIMEOUT_SECONDS=3
A13N_SERVICE_AUTO_MIGRATE=false
A13N_SERVICE_MIGRATION_ADVISORY_LOCK_TIMEOUT_SECONDS=900
A13N_SERVICE_MIGRATION_LOCK_TIMEOUT_SECONDS=3
A13N_SERVICE_MIGRATION_STATEMENT_TIMEOUT_SECONDS=900
A13N_SERVICE_MIGRATION_IDLE_TRANSACTION_TIMEOUT_SECONDS=30
A13N_SERVICE_LOG_LEVEL=INFO
A13N_SERVICE_LOG_FORMAT=pretty

# Optional Agent Harness settings are grouped in `.env.harness.example`.
# Copy only the required entries into the root `.env`; repository commands load
# `.env` and do not merge example files automatically.
