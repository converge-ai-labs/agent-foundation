FOUNDATION_ROLE=all
FOUNDATION_HOST=127.0.0.1
FOUNDATION_PORT=8000
FOUNDATION_CONNECTIVITY_PUBLIC_ORIGIN=http://127.0.0.1:8000
FOUNDATION_CONNECTIVITY_HTTP_ORIGINS='["http://127.0.0.1:8000"]'
# FOUNDATION_CONNECTIVITY_PROVIDER_ORIGINS='["https://hooks.example.com"]'
FOUNDATION_CONNECTIVITY_PROVIDER_REQUEST_MAX_BYTES=1048576
FOUNDATION_CONNECTIVITY_PROTECTED_RAW_RETENTION_SECONDS=0
FOUNDATION_CONNECTIVITY_DEDUP_HORIZON_SECONDS=604800
FOUNDATION_CONNECTIVITY_CATALOG_RETENTION_SECONDS=2592000
FOUNDATION_CONNECTIVITY_RETENTION_POLL_INTERVAL_SECONDS=60
FOUNDATION_CONNECTIVITY_RETENTION_LEASE_SECONDS=60
FOUNDATION_CONNECTIVITY_OBJECT_CLEANUP_GRACE_SECONDS=3600
FOUNDATION_CONNECTIVITY_RETENTION_BATCH_SIZE=25
FOUNDATION_DATABASE_BACKEND=postgresql
FOUNDATION_DATABASE_URL=postgresql+psycopg://foundation:foundation@127.0.0.1:5432/foundation
FOUNDATION_DATABASE_SQLITE_PATH=var/foundation.sqlite3
FOUNDATION_REDIS_BACKEND=redis
FOUNDATION_REDIS_URL=redis://127.0.0.1:6379/0
FOUNDATION_OBJECT_BACKEND=local
FOUNDATION_OBJECT_LOCAL_ROOT=var/objects
# FOUNDATION_OBJECT_BUCKET=foundation-objects
# FOUNDATION_OBJECT_REGION=us-east-1
# FOUNDATION_OBJECT_ENDPOINT_URL=http://127.0.0.1:9000
# FOUNDATION_OBJECT_FORCE_PATH_STYLE=true
FOUNDATION_FILESYSTEM_ROOT=var/files
# Control, connectivity, and all roles require a deployment-managed 32-byte key.
# FOUNDATION_SECRET_MASTER_KEY_BASE64=<standard-base64-encoded-32-byte-key>
# FOUNDATION_SECRET_ENCRYPTION_KEY_ID=master-2026-09
FOUNDATION_DATABASE_CONNECT_TIMEOUT_SECONDS=10
FOUNDATION_DATABASE_STATEMENT_TIMEOUT_SECONDS=30
FOUNDATION_DATABASE_READINESS_TIMEOUT_SECONDS=3
FOUNDATION_AUTO_MIGRATE=false
FOUNDATION_MIGRATION_ADVISORY_LOCK_TIMEOUT_SECONDS=900
FOUNDATION_MIGRATION_LOCK_TIMEOUT_SECONDS=3
FOUNDATION_MIGRATION_STATEMENT_TIMEOUT_SECONDS=900
FOUNDATION_MIGRATION_IDLE_TRANSACTION_TIMEOUT_SECONDS=30
FOUNDATION_LOG_LEVEL=INFO
FOUNDATION_LOG_FORMAT=pretty

# Optional Agent Harness settings are grouped in `.env.harness.example`.
# Copy only the required entries into the root `.env`; repository commands load
# `.env` and do not merge example files automatically.
