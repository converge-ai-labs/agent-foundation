FOUNDATION_ROLE=all
FOUNDATION_HOST=127.0.0.1
FOUNDATION_PORT=8000
FOUNDATION_DATABASE_BACKEND=postgresql
FOUNDATION_DATABASE_URL=postgresql+psycopg://foundation:foundation@127.0.0.1:5432/foundation
FOUNDATION_DATABASE_SQLITE_PATH=var/foundation.sqlite3
FOUNDATION_REDIS_URL=redis://127.0.0.1:6379/0
FOUNDATION_DATABASE_CONNECT_TIMEOUT_SECONDS=10
FOUNDATION_DATABASE_STATEMENT_TIMEOUT_SECONDS=30
FOUNDATION_DATABASE_READINESS_TIMEOUT_SECONDS=3
FOUNDATION_AUTO_MIGRATE=false
FOUNDATION_MIGRATION_ADVISORY_LOCK_TIMEOUT_SECONDS=900
FOUNDATION_MIGRATION_LOCK_TIMEOUT_SECONDS=3
FOUNDATION_MIGRATION_STATEMENT_TIMEOUT_SECONDS=900
FOUNDATION_MIGRATION_IDLE_TRANSACTION_TIMEOUT_SECONDS=30
FOUNDATION_LOG_LEVEL=INFO
FOUNDATION_LOG_FORMAT=pretty
