# Optional environment overrides, NOT automatically loaded by Service.
# For a runnable local setup, use dev/service/local.toml and make service-dev.
# Export only the overrides you need in your process environment.
# Never commit real credentials here or in dev/service/local.toml.
# A13N_SERVICE_SECRET_MASTER_KEY_BASE64=<deployment-managed-base64-key>
# A13N_SERVICE_SECRET_ENCRYPTION_KEY_ID=<deployment-key-id>
# A13N_SERVICE_IAM_SMTP_HOST=<smtp-host>
# A13N_SERVICE_IAM_SMTP_PORT=587
# A13N_SERVICE_IAM_SMTP_TLS=starttls
# A13N_SERVICE_IAM_SMTP_SENDER=<sender-address>
# A13N_SERVICE_IAM_SMTP_USERNAME=<smtp-username>
# A13N_SERVICE_IAM_SMTP_PASSWORD=<smtp-password>
# A13N_SERVICE_OBSERVABILITY_QUERY_LANGFUSE_BASE_URL=<langfuse-origin>
# A13N_SERVICE_OBSERVABILITY_QUERY_LANGFUSE_PUBLIC_KEY=<query-public-key>
# A13N_SERVICE_OBSERVABILITY_QUERY_LANGFUSE_SECRET_KEY=<query-secret-key>
# Standard OTEL_* exporter settings remain independent environment inputs.
# Harness-specific environment options are documented in .env.harness.example.
