/* Agent UI terminal workstation styles. */

Screen {
    layout: vertical;
    background: $surface;
    color: $text;
}

#terminal-status {
    width: 100%;
    height: 1fr;
    content-align: center middle;
    text-align: center;
    padding: 2 4;
}

#focus-screen,
#workbench-screen {
    width: 100%;
    height: 1fr;
}

#focus-header {
    width: 100%;
    height: 3;
    padding: 0 1;
    background: $panel;
    border-bottom: solid $primary;
    align-vertical: middle;
}

#focus-identity {
    width: 1fr;
    text-overflow: ellipsis;
}

#focus-activity {
    width: auto;
    min-width: 12;
    color: $accent;
    text-align: right;
    margin-right: 1;
}

#focus-header Button {
    width: auto;
    min-width: 10;
    height: 1;
    margin-left: 1;
}

#focus-operation-summary,
#focus-notice {
    width: 100%;
    height: auto;
    max-height: 3;
    padding: 0 1;
    background: $boost;
}

#focus-main {
    width: 100%;
    height: 1fr;
}

#focus-draft-intro {
    width: 1fr;
    height: 1fr;
    content-align: center middle;
    text-align: center;
    color: $text-muted;
    padding: 2;
}

#timeline {
    width: 1fr;
    height: 100%;
}

#timeline-scroll {
    width: 100%;
    height: 1fr;
    padding: 1 2;
    scrollbar-gutter: stable;
}

#timeline-older,
#timeline-latest {
    width: 100%;
    height: 1;
    min-height: 1;
    border: none;
}

.timeline-block {
    width: 100%;
    height: auto;
    min-height: 3;
    margin-bottom: 1;
    padding: 0 1;
    border-left: thick $primary-muted;
}

.timeline-block:focus {
    border-left: thick $accent;
    background: $boost;
}

.block-user {
    border-left: thick $success;
}

.block-failure {
    border-left: thick $error;
}

.block-reasoning {
    border-left: thick $secondary;
}

.block-title,
.block-body,
.block-body Markdown {
    width: 100%;
    height: auto;
}

#focus-inspector {
    width: 34;
    min-width: 28;
    height: 100%;
    padding: 1;
    border-left: solid $primary-background;
    background: $panel;
}

.inspector-heading {
    margin-top: 1;
    color: $accent;
    text-style: bold;
}

#composer {
    width: 100%;
    height: 9;
    border-top: solid $primary;
    padding: 0 1;
}

#composer-label {
    width: 100%;
    height: 1;
    text-style: bold;
}

#composer-editor {
    width: 100%;
    height: 5;
}

#composer-actions {
    width: 100%;
    height: 2;
    align-horizontal: right;
}

#composer-submit {
    width: 12;
    height: 1;
    min-height: 1;
}

#decision-pane {
    width: 100%;
    height: 18;
    border-top: solid $warning;
    padding: 0 1;
}

#decision-progress,
#decision-validation {
    width: 100%;
    height: 1;
}

#decision-validation {
    color: $error;
}

#decision-stale {
    width: 100%;
    height: auto;
    max-height: 3;
    color: $warning;
}

#decision-body {
    width: 100%;
    height: 1fr;
    overflow-y: auto;
}

#decision-body Button {
    width: 100%;
    height: auto;
    min-height: 1;
    margin-bottom: 1;
}

#decision-body TextArea {
    height: 5;
}

#decision-navigation {
    width: 100%;
    height: 2;
    align-horizontal: right;
}

#decision-navigation Button {
    width: auto;
    min-width: 10;
    height: 1;
    min-height: 1;
    margin-left: 1;
}

#focus-actions {
    width: 100%;
    height: 1;
    padding: 0 1;
    background: $primary-background;
    color: $text-muted;
    text-align: center;
}

#review-pane {
    layer: overlay;
    width: 100%;
    height: 100%;
    background: $surface;
    padding: 1 2;
    border: tall $accent;
}

#review-title {
    width: 100%;
    height: 2;
    text-style: bold;
}

#review-scroll {
    width: 100%;
    height: 1fr;
}

#review-body {
    width: 100%;
    height: auto;
}

#review-child-controls {
    width: 100%;
    height: 3;
    align-vertical: middle;
}

#review-child-message {
    width: 1fr;
}

#review-child-controls Button {
    width: auto;
    min-width: 12;
    height: 1;
    min-height: 1;
    margin-left: 1;
}

#review-close {
    width: 12;
    height: 1;
    min-height: 1;
    dock: bottom;
}

.width-medium #focus-inspector,
.width-narrow #focus-inspector {
    display: none;
}

.width-narrow #focus-header {
    height: 3;
}

.width-narrow #focus-identity {
    width: 1fr;
}

.width-narrow #focus-activity {
    display: none;
}

.width-narrow #focus-header Button {
    min-width: 8;
    margin-left: 0;
}

.width-narrow #composer {
    height: 8;
}

.width-narrow #decision-pane {
    height: 1fr;
}


#workbench-header {
    width: 100%;
    height: 3;
    padding: 0 1;
    background: $panel;
    border-bottom: solid $primary;
    align-vertical: middle;
}

#workbench-search {
    width: 1fr;
}

#workbench-header Button {
    width: auto;
    min-width: 10;
    height: 1;
    min-height: 1;
    margin-left: 1;
}

#workbench-render-error {
    display: none;
    width: 100%;
    height: 1fr;
    content-align: center middle;
    text-align: center;
    padding: 2;
    color: $error;
}

#workbench-main {
    width: 100%;
    height: 1fr;
}

#workbench-list-pane {
    width: 1fr;
    height: 100%;
    border-right: solid $primary-background;
}

#workbench-list {
    width: 100%;
    height: 1fr;
}

#workbench-list ListItem {
    width: 100%;
    height: 3;
    padding: 0 1;
}

#workbench-more {
    width: 100%;
    height: 1;
    min-height: 1;
    border: none;
}

#workbench-preview {
    width: 2fr;
    height: 100%;
    padding: 1 2;
    background: $panel;
}

#workbench-preview-title {
    width: 100%;
    height: auto;
    text-style: bold;
    color: $accent;
}

#workbench-preview-body {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

#workbench-preview-actions {
    width: 100%;
    height: 2;
}

#workbench-preview-actions Button {
    width: auto;
    min-width: 10;
    height: 1;
    min-height: 1;
    margin-right: 1;
}

#workbench-composer-label {
    width: 100%;
    height: 1;
    margin-top: 1;
    text-style: bold;
}

#workbench-editor {
    width: 100%;
    height: 7;
}

#workbench-submit {
    width: 12;
    height: 1;
    min-height: 1;
    margin-top: 1;
}

#workbench-view-toggle {
    display: none;
}

#workbench-footer {
    width: 100%;
    height: 1;
    padding: 0 1;
    text-align: center;
    color: $text-muted;
    background: $primary-background;
}

#overlay-pane {
    layer: overlay;
    width: 80%;
    height: 80%;
    offset: 10% 10%;
    background: $surface;
    border: tall $accent;
    padding: 1 2;
}

#overlay-title {
    width: 100%;
    height: 2;
    text-style: bold;
}

#overlay-search {
    width: 100%;
    height: 3;
}

#overlay-scope {
    width: 100%;
    height: 1;
    min-height: 1;
    border: none;
}

#overlay-body {
    width: 100%;
    height: 1fr;
    overflow-y: auto;
}

#overlay-list {
    width: 100%;
    height: 1fr;
}

#overlay-list ListItem {
    width: 100%;
    height: auto;
    min-height: 3;
    padding: 0 1;
}

#overlay-confirm-exit,
#overlay-close {
    width: auto;
    min-width: 12;
    height: 1;
    min-height: 1;
    margin-right: 1;
}

#completion-popup {
    layer: overlay;
    width: 70%;
    height: 14;
    offset: 15% 55%;
    background: $surface;
    border: tall $accent;
    padding: 0 1;
}

#completion-title {
    width: 100%;
    height: 1;
    text-style: bold;
}

#completion-list {
    width: 100%;
    height: 1fr;
}

#completion-list ListItem {
    width: 100%;
    height: auto;
    min-height: 2;
}

.width-medium #workbench-view-toggle,
.width-narrow #workbench-view-toggle {
    display: block;
}

.width-medium #workbench-list-pane,
.width-narrow #workbench-list-pane {
    width: 100%;
    border-right: none;
}

.width-medium #workbench-preview,
.width-narrow #workbench-preview {
    display: none;
}

.width-medium #workbench-screen.show-preview #workbench-list-pane,
.width-narrow #workbench-screen.show-preview #workbench-list-pane {
    display: none;
}

.width-medium #workbench-screen.show-preview #workbench-preview,
.width-narrow #workbench-screen.show-preview #workbench-preview {
    display: block;
    width: 100%;
}

.width-narrow #workbench-header Button {
    min-width: 7;
    margin-left: 0;
}

.width-narrow #overlay-pane {
    width: 100%;
    height: 100%;
    offset: 0 0;
}

.width-narrow #completion-popup {
    width: 100%;
    offset: 0 50%;
}
