/* Agent UI terminal workstation styles. */

Screen {
    layout: vertical;
    background: $surface;
    color: $text;
}

#terminal-status {
    width: 100%;
    height: 1fr;
    content-align: center middle;
    text-align: center;
    padding: 2 4;
}

#focus-screen,
#workbench-screen {
    width: 100%;
    height: 1fr;
}

#focus-header {
    width: 100%;
    height: 3;
    padding: 0 1;
    background: $panel;
    border-bottom: solid $primary;
    align-vertical: middle;
}

#focus-identity {
    width: 1fr;
    text-overflow: ellipsis;
}

#focus-activity {
    width: auto;
    min-width: 12;
    color: $accent;
    text-align: right;
    margin-right: 1;
}

#focus-header Button {
    width: auto;
    min-width: 10;
    height: 1;
    margin-left: 1;
}

#focus-operation-summary,
#focus-notice {
    width: 100%;
    height: auto;
    max-height: 3;
    padding: 0 1;
    background: $boost;
}

#focus-main {
    width: 100%;
    height: 1fr;
}

#focus-draft-intro {
    width: 1fr;
    height: 1fr;
    content-align: center middle;
    text-align: center;
    color: $text-muted;
    padding: 2;
}

#timeline {
    width: 1fr;
    height: 100%;
}

#timeline-scroll {
    width: 100%;
    height: 1fr;
    padding: 1 2;
    scrollbar-gutter: stable;
}

#timeline-older,
#timeline-latest {
    width: 100%;
    height: 1;
    min-height: 1;
    border: none;
}

.timeline-block {
    width: 100%;
    height: auto;
    min-height: 3;
    margin-bottom: 1;
    padding: 0 1;
    border-left: thick $primary-muted;
}

.timeline-block:focus {
    border-left: thick $accent;
    background: $boost;
}

.block-user {
    border-left: thick $success;
}

.block-failure {
    border-left: thick $error;
}

.block-reasoning {
    border-left: thick $secondary;
}

.block-title,
.block-body,
.block-body Markdown {
    width: 100%;
    height: auto;
}

#focus-inspector {
    width: 34;
    min-width: 28;
    height: 100%;
    padding: 1;
    border-left: solid $primary-background;
    background: $panel;
}

.inspector-heading {
    margin-top: 1;
    color: $accent;
    text-style: bold;
}

#composer {
    width: 100%;
    height: 9;
    border-top: solid $primary;
    padding: 0 1;
}

#composer-label {
    width: 100%;
    height: 1;
    text-style: bold;
}

#composer-editor {
    width: 100%;
    height: 5;
}

#composer-actions {
    width: 100%;
    height: 2;
    align-horizontal: right;
}

#composer-submit {
    width: 12;
    height: 1;
    min-height: 1;
}

#decision-pane {
    width: 100%;
    height: 18;
    border-top: solid $warning;
    padding: 0 1;
}

#decision-progress,
#decision-validation {
    width: 100%;
    height: 1;
}

#decision-validation {
    color: $error;
}

#decision-stale {
    width: 100%;
    height: auto;
    max-height: 3;
    color: $warning;
}

#decision-body {
    width: 100%;
    height: 1fr;
    overflow-y: auto;
}

#decision-body Button {
    width: 100%;
    height: auto;
    min-height: 1;
    margin-bottom: 1;
}

#decision-body TextArea {
    height: 5;
}

#decision-navigation {
    width: 100%;
    height: 2;
    align-horizontal: right;
}

#decision-navigation Button {
    width: auto;
    min-width: 10;
    height: 1;
    min-height: 1;
    margin-left: 1;
}

#focus-actions {
    width: 100%;
    height: 1;
    padding: 0 1;
    background: $primary-background;
    color: $text-muted;
    text-align: center;
}

#review-pane {
    layer: overlay;
    width: 100%;
    height: 100%;
    background: $surface;
    padding: 1 2;
    border: tall $accent;
}

#review-title {
    width: 100%;
    height: 2;
    text-style: bold;
}

#review-scroll {
    width: 100%;
    height: 1fr;
}

#review-body {
    width: 100%;
    height: auto;
}

#review-child-controls {
    width: 100%;
    height: 3;
    align-vertical: middle;
}

#review-child-message {
    width: 1fr;
}

#review-child-controls Button {
    width: auto;
    min-width: 12;
    height: 1;
    min-height: 1;
    margin-left: 1;
}

#review-close {
    width: 12;
    height: 1;
    min-height: 1;
    dock: bottom;
}

.width-medium #focus-inspector,
.width-narrow #focus-inspector {
    display: none;
}

.width-narrow #focus-header {
    height: 2;
}

.width-narrow #focus-identity {
    width: 1fr;
}

.width-narrow #focus-header Button {
    display: none;
}

.width-narrow #composer {
    height: 8;
}

.width-narrow #decision-pane {
    height: 1fr;
}
