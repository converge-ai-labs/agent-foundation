{
  "$defs": {
    "AgentModelCharacteristics": {
      "additionalProperties": false,
      "description": "The agent's context policy, layered over what the model declares.",
      "properties": {
        "compact_threshold": {
          "default": 0.9,
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Compact Threshold",
          "type": "number"
        },
        "context_window_tokens": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context Window Tokens"
        },
        "proactive_context_management_threshold": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": 0.65,
          "title": "Proactive Context Management Threshold"
        }
      },
      "title": "AgentModelCharacteristics",
      "type": "object"
    },
    "AgentReviewer": {
      "additionalProperties": false,
      "description": "The model reviewing calls whose permission is `review`, selected by model key.",
      "properties": {
        "instruction": {
          "anyOf": [
            {
              "maxLength": 32768,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instruction"
        },
        "model": {
          "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$",
          "title": "Model",
          "type": "string"
        },
        "model_settings": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Settings"
        },
        "on_error": {
          "default": "approval_required",
          "enum": [
            "deny",
            "approval_required",
            "allow"
          ],
          "title": "On Error",
          "type": "string"
        },
        "on_flagged": {
          "default": "deny",
          "enum": [
            "deny",
            "approval_required"
          ],
          "title": "On Flagged",
          "type": "string"
        },
        "risk_threshold": {
          "$ref": "#/$defs/ToolRiskLevel",
          "default": "extra_high"
        },
        "rules": {
          "additionalProperties": {
            "$ref": "#/$defs/ToolReviewRule"
          },
          "maxProperties": 1024,
          "title": "Rules",
          "type": "object"
        },
        "shell_instruction": {
          "anyOf": [
            {
              "maxLength": 32768,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shell Instruction"
        },
        "timeout_seconds": {
          "default": 120,
          "exclusiveMinimum": 0,
          "maximum": 120,
          "title": "Timeout Seconds",
          "type": "number"
        }
      },
      "required": [
        "model"
      ],
      "title": "AgentReviewer",
      "type": "object"
    },
    "ChildEnvironmentPolicy": {
      "additionalProperties": false,
      "description": "What a child run mounts: no environment, the parent's, or a new one from `template_id`.",
      "properties": {
        "mode": {
          "default": "shared",
          "enum": [
            "none",
            "shared",
            "dedicated"
          ],
          "title": "Mode",
          "type": "string"
        },
        "template_id": {
          "anyOf": [
            {
              "maxLength": 41,
              "pattern": "^[a-z][a-z0-9]{1,7}_[0-9a-f]{20,32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Template Id"
        }
      },
      "title": "ChildEnvironmentPolicy",
      "type": "object"
    },
    "ClientToolDefinition": {
      "additionalProperties": false,
      "description": "Portable model guidance for one externally executed client tool.",
      "properties": {
        "description": {
          "maxLength": 16384,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "instruction": {
          "anyOf": [
            {
              "maxLength": 16384,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instruction"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*$",
          "title": "Name",
          "type": "string"
        },
        "parameters_json_schema": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters Json Schema",
          "type": "object"
        },
        "permission": {
          "default": "inherit",
          "enum": [
            "inherit",
            "allow",
            "deny"
          ],
          "title": "Permission",
          "type": "string"
        }
      },
      "required": [
        "name",
        "description",
        "parameters_json_schema"
      ],
      "title": "ClientToolDefinition",
      "type": "object"
    },
    "ConnectionSelection": {
      "additionalProperties": false,
      "description": "An agent's use of one connection: all the tools it exposes, or a subset, and their permissions.",
      "properties": {
        "connection_id": {
          "maxLength": 41,
          "pattern": "^[a-z][a-z0-9]{1,7}_[0-9a-f]{20,32}$",
          "title": "Connection Id",
          "type": "string"
        },
        "permission": {
          "$ref": "#/$defs/ToolPermissionSetting",
          "default": "inherit"
        },
        "permissions": {
          "additionalProperties": {
            "$ref": "#/$defs/ToolPermissionSetting"
          },
          "maxProperties": 128,
          "propertyNames": {
            "maxLength": 128,
            "minLength": 1
          },
          "title": "Permissions",
          "type": "object"
        },
        "tools": {
          "anyOf": [
            {
              "items": {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 128,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tools"
        }
      },
      "required": [
        "connection_id"
      ],
      "title": "ConnectionSelection",
      "type": "object"
    },
    "DelegationContextPolicy": {
      "additionalProperties": false,
      "properties": {
        "history": {
          "default": "none",
          "enum": [
            "none",
            "summary",
            "selected"
          ],
          "title": "History",
          "type": "string"
        },
        "include_task": {
          "default": true,
          "title": "Include Task",
          "type": "boolean"
        },
        "task_state": {
          "default": "shared",
          "enum": [
            "shared",
            "isolated"
          ],
          "title": "Task State",
          "type": "string"
        }
      },
      "title": "DelegationContextPolicy",
      "type": "object"
    },
    "IsolatedSkillSync": {
      "additionalProperties": false,
      "description": "Reuse immutable package directories, with a soft count budget.",
      "properties": {
        "cache_count": {
          "default": 128,
          "minimum": 0,
          "title": "Cache Count",
          "type": "integer"
        },
        "mode": {
          "const": "isolated",
          "default": "isolated",
          "title": "Mode",
          "type": "string"
        }
      },
      "title": "IsolatedSkillSync",
      "type": "object"
    },
    "JsonValue": {},
    "MediaUnderstandingSelection": {
      "additionalProperties": false,
      "description": "The model, by key, describing each media kind a model cannot read; a kind without one is unavailable.",
      "properties": {
        "audio": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audio"
        },
        "image": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image"
        },
        "video": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Video"
        }
      },
      "title": "MediaUnderstandingSelection",
      "type": "object"
    },
    "MemoryAccess": {
      "enum": [
        "read",
        "write"
      ],
      "type": "string"
    },
    "MemoryMount": {
      "additionalProperties": false,
      "description": "A memory under the name the model addresses it by, exposing the tools its access allows. `recall` lets a\nrecord memory recall records into each run's first input; file memories ignore it.",
      "properties": {
        "access": {
          "$ref": "#/$defs/MemoryAccess"
        },
        "memory_id": {
          "maxLength": 41,
          "pattern": "^[a-z][a-z0-9]{1,7}_[0-9a-f]{20,32}$",
          "title": "Memory Id",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "title": "Name",
          "type": "string"
        },
        "recall": {
          "default": true,
          "title": "Recall",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "memory_id",
        "access"
      ],
      "title": "MemoryMount",
      "type": "object"
    },
    "OutputSpec": {
      "additionalProperties": false,
      "description": "Plain text without a schema, one structured output, or at least two named variants.\n\n`resources` are the schemas `$ref`s may name besides the schema's own definitions.",
      "properties": {
        "description": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "name": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "resources": {
          "maxProperties": 128,
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_.:-]{0,127}$": {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            }
          },
          "title": "Resources",
          "type": "object"
        },
        "schema": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schema"
        },
        "variants": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/OutputVariant"
              },
              "maxItems": 32,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variants"
        }
      },
      "title": "OutputSpec",
      "type": "object"
    },
    "OutputVariant": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]{0,127}$",
          "title": "Name",
          "type": "string"
        },
        "resources": {
          "maxProperties": 128,
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_.:-]{0,127}$": {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            }
          },
          "title": "Resources",
          "type": "object"
        },
        "schema": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Schema",
          "type": "object"
        }
      },
      "required": [
        "name",
        "schema"
      ],
      "title": "OutputVariant",
      "type": "object"
    },
    "PlatformGroup": {
      "enum": [
        "agents",
        "models",
        "connections",
        "skills",
        "environment_templates",
        "providers",
        "execution",
        "schedules"
      ],
      "type": "string"
    },
    "PluginSelection": {
      "additionalProperties": false,
      "description": "One instance of a Harness plugin factory the deployment installed.",
      "properties": {
        "config": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Config",
          "type": "object"
        },
        "instance_name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]{0,127}$",
          "title": "Instance Name",
          "type": "string"
        },
        "plugin_key": {
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Plugin Key",
          "type": "string"
        }
      },
      "required": [
        "instance_name",
        "plugin_key"
      ],
      "title": "PluginSelection",
      "type": "object"
    },
    "RetryConfig": {
      "additionalProperties": false,
      "properties": {
        "output": {
          "default": 0,
          "maximum": 100,
          "minimum": 0,
          "title": "Output",
          "type": "integer"
        },
        "tools": {
          "default": 0,
          "maximum": 100,
          "minimum": 0,
          "title": "Tools",
          "type": "integer"
        }
      },
      "title": "RetryConfig",
      "type": "object"
    },
    "SessionMemorySettings": {
      "additionalProperties": false,
      "description": "Participation and complete Space selection; policy belongs to each Space.",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "spaces": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SpaceBinding"
          },
          "maxItems": 32,
          "title": "Spaces",
          "type": "array"
        }
      },
      "title": "SessionMemorySettings",
      "type": "object"
    },
    "SharedSkillSync": {
      "additionalProperties": false,
      "description": "Publish mutable conventional names; the last completed publication wins.",
      "properties": {
        "cleanup": {
          "default": false,
          "title": "Cleanup",
          "type": "boolean"
        },
        "mode": {
          "const": "shared",
          "default": "shared",
          "title": "Mode",
          "type": "string"
        },
        "overwrite": {
          "default": true,
          "title": "Overwrite",
          "type": "boolean"
        }
      },
      "title": "SharedSkillSync",
      "type": "object"
    },
    "SkillSelection": {
      "additionalProperties": false,
      "properties": {
        "revision_id": {
          "anyOf": [
            {
              "maxLength": 41,
              "pattern": "^[a-z][a-z0-9]{1,7}_[0-9a-f]{20,32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision Id"
        },
        "skill_id": {
          "maxLength": 41,
          "pattern": "^[a-z][a-z0-9]{1,7}_[0-9a-f]{20,32}$",
          "title": "Skill Id",
          "type": "string"
        }
      },
      "required": [
        "skill_id"
      ],
      "title": "SkillSelection",
      "type": "object"
    },
    "SpaceBinding": {
      "additionalProperties": false,
      "description": "A named Space selected by the App or inherited from Agent defaults.",
      "properties": {
        "access": {
          "$ref": "#/$defs/MemoryAccess",
          "default": "write"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "title": "Name",
          "type": "string"
        },
        "space_id": {
          "maxLength": 41,
          "pattern": "^[a-z][a-z0-9]{1,7}_[0-9a-f]{20,32}$",
          "title": "Space Id",
          "type": "string"
        }
      },
      "required": [
        "name",
        "space_id"
      ],
      "title": "SpaceBinding",
      "type": "object"
    },
    "SubagentSelection": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "maxLength": 41,
          "pattern": "^[a-z][a-z0-9]{1,7}_[0-9a-f]{20,32}$",
          "title": "Agent Id",
          "type": "string"
        },
        "context": {
          "$ref": "#/$defs/DelegationContextPolicy"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "environment": {
          "$ref": "#/$defs/ChildEnvironmentPolicy"
        },
        "revision_id": {
          "anyOf": [
            {
              "maxLength": 41,
              "pattern": "^[a-z][a-z0-9]{1,7}_[0-9a-f]{20,32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision Id"
        },
        "usage_limits": {
          "anyOf": [
            {
              "$ref": "#/$defs/UsageLimits"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "agent_id"
      ],
      "title": "SubagentSelection",
      "type": "object"
    },
    "ToolPermissionMode": {
      "enum": [
        "allow",
        "deny",
        "ask",
        "review"
      ],
      "type": "string"
    },
    "ToolPermissionSetting": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolPermissionMode"
        },
        {
          "const": "inherit",
          "type": "string"
        }
      ]
    },
    "ToolReviewRule": {
      "additionalProperties": false,
      "description": "A matching rule overrides the supplied fields of the global policy.",
      "properties": {
        "on_flagged": {
          "anyOf": [
            {
              "enum": [
                "deny",
                "approval_required"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "On Flagged"
        },
        "risk_threshold": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolRiskLevel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "ToolReviewRule",
      "type": "object"
    },
    "ToolRiskLevel": {
      "enum": [
        "low",
        "medium",
        "high",
        "extra_high"
      ],
      "title": "ToolRiskLevel",
      "type": "string"
    },
    "ToolSearch": {
      "additionalProperties": false,
      "description": "Presentation of already-selected sources, composed by Harness once per agent.",
      "properties": {
        "config": {
          "$ref": "#/$defs/ToolSearchConfig"
        },
        "groups": {
          "additionalProperties": {
            "$ref": "#/$defs/ToolSearchGroup"
          },
          "maxProperties": 128,
          "title": "Groups",
          "type": "object"
        }
      },
      "title": "ToolSearch",
      "type": "object"
    },
    "ToolSearchConfig": {
      "additionalProperties": false,
      "description": "Names and bounded discovery settings for one Agent's proxy surface.",
      "properties": {
        "call_name": {
          "default": "call_tool",
          "title": "Call Name",
          "type": "string"
        },
        "describe_name": {
          "default": "describe_tool",
          "title": "Describe Name",
          "type": "string"
        },
        "groups_name": {
          "default": "list_tool_groups",
          "title": "Groups Name",
          "type": "string"
        },
        "list_name": {
          "default": "list_tools",
          "title": "List Name",
          "type": "string"
        },
        "max_results": {
          "default": 10,
          "title": "Max Results",
          "type": "integer"
        },
        "max_search_bytes": {
          "default": 32768,
          "title": "Max Search Bytes",
          "type": "integer"
        },
        "mode": {
          "const": "proxy",
          "default": "proxy",
          "title": "Mode",
          "type": "string"
        },
        "search_name": {
          "default": "discover_tools",
          "title": "Search Name",
          "type": "string"
        }
      },
      "title": "ProxyToolSearchConfig",
      "type": "object"
    },
    "ToolSearchGroup": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "default": [],
          "items": {
            "enum": [
              "environment",
              "web"
            ],
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "connections": {
          "default": [],
          "items": {
            "maxLength": 41,
            "pattern": "^[a-z][a-z0-9]{1,7}_[0-9a-f]{20,32}$",
            "type": "string"
          },
          "maxItems": 128,
          "title": "Connections",
          "type": "array"
        },
        "description": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "platform": {
          "default": false,
          "title": "Platform",
          "type": "boolean"
        },
        "plugins": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 128,
          "title": "Plugins",
          "type": "array"
        }
      },
      "required": [
        "description"
      ],
      "title": "ToolSearchGroup",
      "type": "object"
    },
    "ToolSelection": {
      "additionalProperties": false,
      "properties": {
        "config": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Config",
          "type": "object"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "permission": {
          "$ref": "#/$defs/ToolPermissionSetting",
          "default": "inherit"
        }
      },
      "title": "ToolSelection",
      "type": "object"
    },
    "ToolsetKey": {
      "anyOf": [
        {
          "enum": [
            "files",
            "shell",
            "computer",
            "web",
            "memory",
            "assets"
          ],
          "type": "string"
        },
        {
          "$ref": "#/$defs/PlatformGroup"
        }
      ]
    },
    "ToolsetSelection": {
      "additionalProperties": false,
      "properties": {
        "config": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Config",
          "type": "object"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "tools": {
          "maxProperties": 64,
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,63}$": {
              "$ref": "#/$defs/ToolSelection"
            }
          },
          "title": "Tools",
          "type": "object"
        }
      },
      "title": "ToolsetSelection",
      "type": "object"
    },
    "UsageLimits": {
      "description": "Limits on model usage.\n\nThe request count is tracked by Pydantic AI, and the request limit is checked at the start of each step of the\nagent loop. Token counts are provided in responses from the model, and the token limits are checked after each response.\n\nEach of the limits can be set to `None` to disable that limit.",
      "properties": {
        "cost_limit": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Limit"
        },
        "count_tokens_before_request": {
          "default": false,
          "title": "Count Tokens Before Request",
          "type": "boolean"
        },
        "input_tokens_limit": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens Limit"
        },
        "output_tokens_limit": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens Limit"
        },
        "per_request_input_tokens_limit": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Per Request Input Tokens Limit"
        },
        "request_limit": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 50,
          "title": "Request Limit"
        },
        "tool_calls_limit": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Calls Limit"
        },
        "total_tokens_limit": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Tokens Limit"
        }
      },
      "title": "UsageLimits",
      "type": "object"
    }
  },
