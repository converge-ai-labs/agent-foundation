{
  "$schema": "./agent-schema.json",
  "model": "openai:gpt-5",
  "name": "compatibility-agent",
  "description": "Fixed representative Harness AgentSpec compatibility baseline.",
  "instructions": ["Preserve the supplied facts.", "Return the requested structured answer."],
  "system_prompt": ["You are a careful assistant.", "Do not invent missing evidence."],
  "toolset_instructions": false,
  "cold_start_filter": {
    "idle_seconds": 7200,
    "max_string_chars": 12000,
    "keep_head_chars": 4000,
    "keep_tail_chars": 2000
  },
  "model_characteristics": {
    "capabilities": ["image_understanding", "audio_understanding", "video_understanding"],
    "context_window": 128000,
    "proactive_context_management_threshold": 0.5,
    "compact_threshold": 0.8
  },
  "model_settings": {
    "temperature": 0.2,
    "max_tokens": 2048,
    "timeout": 30,
    "parallel_tool_calls": false,
    "extra_headers": {"X-Compatibility-Test": "fixture"}
  },
  "usage_limits": {
    "request_limit": 12,
    "tool_calls_limit": 8,
    "input_tokens_limit": 64000,
    "output_tokens_limit": 4096,
    "total_tokens_limit": 68096,
    "per_request_input_tokens_limit": 32000,
    "count_tokens_before_request": false
  },
  "deps_schema": {
    "type": "object",
    "properties": {"locale": {"type": "string"}},
    "required": ["locale"],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "summary": {"type": "string"},
      "score": {"type": "integer", "minimum": 1}
    },
    "required": ["summary", "score"],
    "additionalProperties": false
  },
  "retries": {"tools": 2, "output": 3},
  "end_strategy": "exhaustive",
  "tool_timeout": 4.5,
  "metadata": {"purpose": "compatibility", "labels": ["fixed", "offline"], "nested": {"enabled": true}},
  "capabilities": [
    {"Thinking": {"effort": "low"}},
    "IncludeToolReturnSchemas",
    {"SetToolMetadata": {"tools": ["echo"], "compatibility": {"fixture": true}}},
    {
      "name": "ToolPermissionsCapability",
      "arguments": {
        "default": "deny",
        "rules": {"environment.*": "ask", "environment.read": "allow"}
      }
    }
  ]
}
