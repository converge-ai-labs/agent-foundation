{
  "$defs": {
    "AppendItem": {
      "additionalProperties": false,
      "description": "Append only new text, without retransmitting the growing item.",
      "properties": {
        "ended_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ended At"
        },
        "field": {
          "enum": [
            "text",
            "arguments"
          ],
          "title": "Field",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "last_stream_id": {
          "title": "Last Stream Id",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ItemState"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "append",
          "default": "append",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "field",
        "text",
        "last_stream_id",
        "state",
        "ended_at"
      ],
      "title": "AppendItem",
      "type": "object"
    },
    "Boundary": {
      "description": "The run committed a checkpoint whose display covers the attempt up to `sequence`.",
      "properties": {
        "attempt": {
          "title": "Attempt",
          "type": "integer"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "sequence": {
          "title": "Sequence",
          "type": "integer"
        }
      },
      "required": [
        "run_id",
        "attempt",
        "sequence"
      ],
      "title": "Boundary",
      "type": "object"
    },
    "Changed": {
      "properties": {
        "version": {
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "version"
      ],
      "title": "Changed",
      "type": "object"
    },
    "Delta": {
      "description": "One contiguous batch of compact display changes, already interpreted by the shared fold.",
      "properties": {
        "attempt": {
          "title": "Attempt",
          "type": "integer"
        },
        "changes": {
          "items": {
            "$ref": "#/$defs/ItemChange"
          },
          "title": "Changes",
          "type": "array"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "sequence": {
          "title": "Sequence",
          "type": "integer"
        }
      },
      "required": [
        "run_id",
        "attempt",
        "sequence",
        "changes"
      ],
      "title": "Delta",
      "type": "object"
    },
    "Gap": {
      "description": "Missing output through this position, or unknown after transport loss.",
      "properties": {
        "position": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]{0,19})-(0|[1-9][0-9]{0,19})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id"
      ],
      "title": "Gap",
      "type": "object"
    },
    "Item": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Content",
          "type": "object"
        },
        "ended_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ended At"
        },
        "first_stream_id": {
          "title": "First Stream Id",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ItemKind"
        },
        "last_stream_id": {
          "title": "Last Stream Id",
          "type": "string"
        },
        "ordinal": {
          "minimum": 1,
          "title": "Ordinal",
          "type": "integer"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ItemState"
        }
      },
      "required": [
        "id",
        "ordinal",
        "kind",
        "state",
        "first_stream_id",
        "last_stream_id",
        "started_at",
        "content"
      ],
      "title": "Item",
      "type": "object"
    },
    "ItemChange": {
      "discriminator": {
        "mapping": {
          "append": "#/$defs/AppendItem",
          "set": "#/$defs/SetItem"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/SetItem"
        },
        {
          "$ref": "#/$defs/AppendItem"
        }
      ]
    },
    "ItemKind": {
      "enum": [
        "text_message",
        "reasoning_message",
        "tool_call",
        "observation"
      ],
      "type": "string"
    },
    "ItemState": {
      "enum": [
        "in_progress",
        "completed",
        "interrupted",
        "failed"
      ],
      "type": "string"
    },
    "JsonValue": {},
    "RunSignal": {
      "description": "The payload of `reset` and `gap`.",
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id"
      ],
      "title": "RunSignal",
      "type": "object"
    },
    "SetItem": {
      "additionalProperties": false,
      "description": "Insert or replace one compact item; the Host assigns its stable identity.",
      "properties": {
        "item": {
          "$ref": "#/$defs/Item"
        },
        "type": {
          "const": "set",
          "default": "set",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "item"
      ],
      "title": "SetItem",
      "type": "object"
    }
  },
  "frames": {
    "boundary": {
      "$ref": "#/$defs/Boundary"
    },
    "changed": {
      "$ref": "#/$defs/Changed"
    },
    "delta": {
      "$ref": "#/$defs/Delta"
    },
    "gap": {
      "$ref": "#/$defs/Gap"
    },
    "reset": {
      "$ref": "#/$defs/RunSignal"
    }
  },
  "title": "Thread stream frames"
}
