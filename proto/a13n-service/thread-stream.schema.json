{
  "$defs": {
    "Boundary": {
      "description": "The run committed a checkpoint whose display covers the attempt up to `sequence`.",
      "properties": {
        "attempt": {
          "title": "Attempt",
          "type": "integer"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "sequence": {
          "title": "Sequence",
          "type": "integer"
        }
      },
      "required": [
        "run_id",
        "attempt",
        "sequence"
      ],
      "title": "Boundary",
      "type": "object"
    },
    "Changed": {
      "properties": {
        "version": {
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "version"
      ],
      "title": "Changed",
      "type": "object"
    },
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "anyOf": [
            {
              "$ref": "#/$defs/CitationAnchor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/CitationSource"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "sources"
      ],
      "title": "Citation",
      "type": "object"
    },
    "CitationAnchor": {
      "additionalProperties": false,
      "description": "Half-open Unicode code-point range in the item's text.",
      "properties": {
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "content",
            "marker"
          ],
          "title": "Kind",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "start",
        "end"
      ],
      "title": "CitationAnchor",
      "type": "object"
    },
    "CitationSource": {
      "discriminator": {
        "mapping": {
          "document": "#/$defs/DocumentCitationSource",
          "web": "#/$defs/WebCitationSource"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/WebCitationSource"
        },
        {
          "$ref": "#/$defs/DocumentCitationSource"
        }
      ]
    },
    "Delta": {
      "description": "One raw AG-UI event, sequenced by the producer and correlated to its display item.",
      "properties": {
        "attempt": {
          "title": "Attempt",
          "type": "integer"
        },
        "event": {
          "additionalProperties": true,
          "title": "Event",
          "type": "object"
        },
        "item": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "sequence": {
          "title": "Sequence",
          "type": "integer"
        }
      },
      "required": [
        "run_id",
        "attempt",
        "sequence",
        "event",
        "item"
      ],
      "title": "Delta",
      "type": "object"
    },
    "DocumentCitationSource": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Id"
        },
        "excerpts": {
          "default": [],
          "items": {
            "maxLength": 512,
            "type": "string"
          },
          "maxItems": 2,
          "title": "Excerpts",
          "type": "array"
        },
        "kind": {
          "const": "document",
          "default": "document",
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "title": "DocumentCitationSource",
      "type": "object"
    },
    "FileSource": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "title": "FileSource",
      "type": "object"
    },
    "Gap": {
      "description": "Missing output through this position, or unknown after transport loss.",
      "properties": {
        "position": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]{0,19})-(0|[1-9][0-9]{0,19})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id"
      ],
      "title": "Gap",
      "type": "object"
    },
    "ItemKind": {
      "enum": [
        "text_message",
        "reasoning_message",
        "tool_call",
        "observation"
      ],
      "type": "string"
    },
    "ItemRef": {
      "description": "The item a live event changed, and its state after the event.",
      "properties": {
        "citations": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Citation"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Citations"
        },
        "failure": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ItemKind"
        },
        "memory_sources": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/MemorySource"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Sources"
        },
        "ordinal": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ordinal"
        },
        "response_group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Group"
        },
        "state": {
          "$ref": "#/$defs/ItemState"
        }
      },
      "required": [
        "id",
        "kind",
        "state"
      ],
      "title": "ItemRef",
      "type": "object"
    },
    "ItemState": {
      "enum": [
        "in_progress",
        "completed",
        "interrupted",
        "failed"
      ],
      "type": "string"
    },
    "JsonValue": {},
    "MemorySource": {
      "additionalProperties": false,
      "description": "One automatic delivery in this Run; content remains in the memory or execution archive.",
      "properties": {
        "cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cursor"
        },
        "files": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FileSource"
          },
          "title": "Files",
          "type": "array"
        },
        "kind": {
          "enum": [
            "record",
            "file"
          ],
          "title": "Kind",
          "type": "string"
        },
        "memory": {
          "title": "Memory",
          "type": "string"
        },
        "memory_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Id"
        },
        "records": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RecordSource"
          },
          "title": "Records",
          "type": "array"
        },
        "sources_truncated": {
          "default": false,
          "title": "Sources Truncated",
          "type": "boolean"
        },
        "status": {
          "enum": [
            "recalled",
            "failed",
            "timeout",
            "full",
            "changes",
            "unchanged",
            "omitted",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "memory",
        "status"
      ],
      "title": "MemorySource",
      "type": "object"
    },
    "RecordSource": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "sha256"
      ],
      "title": "RecordSource",
      "type": "object"
    },
    "RunSignal": {
      "description": "The payload of `reset` and `gap`.",
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id"
      ],
      "title": "RunSignal",
      "type": "object"
    },
    "WebCitationSource": {
      "additionalProperties": false,
      "properties": {
        "excerpts": {
          "default": [],
          "items": {
            "maxLength": 512,
            "type": "string"
          },
          "maxItems": 2,
          "title": "Excerpts",
          "type": "array"
        },
        "kind": {
          "const": "web",
          "default": "web",
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "url": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "title": "WebCitationSource",
      "type": "object"
    }
  },
  "frames": {
    "boundary": {
      "$ref": "#/$defs/Boundary"
    },
    "changed": {
      "$ref": "#/$defs/Changed"
    },
    "delta": {
      "$ref": "#/$defs/Delta"
    },
    "gap": {
      "$ref": "#/$defs/Gap"
    },
    "reset": {
      "$ref": "#/$defs/RunSignal"
    }
  },
  "title": "Thread stream frames"
}
