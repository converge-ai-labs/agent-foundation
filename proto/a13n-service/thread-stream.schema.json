{
  "$defs": {
    "Boundary": {
      "description": "The run committed a checkpoint whose display covers the attempt up to `sequence`.",
      "properties": {
        "attempt": {
          "title": "Attempt",
          "type": "integer"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "sequence": {
          "title": "Sequence",
          "type": "integer"
        }
      },
      "required": [
        "run_id",
        "attempt",
        "sequence"
      ],
      "title": "Boundary",
      "type": "object"
    },
    "Changed": {
      "properties": {
        "version": {
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "version"
      ],
      "title": "Changed",
      "type": "object"
    },
    "Delta": {
      "description": "One raw AG-UI event, sequenced by the producer and correlated to its display item.",
      "properties": {
        "attempt": {
          "title": "Attempt",
          "type": "integer"
        },
        "event": {
          "additionalProperties": true,
          "title": "Event",
          "type": "object"
        },
        "item": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "sequence": {
          "title": "Sequence",
          "type": "integer"
        }
      },
      "required": [
        "run_id",
        "attempt",
        "sequence",
        "event",
        "item"
      ],
      "title": "Delta",
      "type": "object"
    },
    "FileSource": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "title": "FileSource",
      "type": "object"
    },
    "Gap": {
      "description": "Missing output through this position, or unknown after transport loss.",
      "properties": {
        "position": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]{0,19})-(0|[1-9][0-9]{0,19})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id"
      ],
      "title": "Gap",
      "type": "object"
    },
    "ItemKind": {
      "enum": [
        "text_message",
        "reasoning_message",
        "tool_call",
        "observation"
      ],
      "type": "string"
    },
    "ItemRef": {
      "description": "The item a live event changed, and its state after the event.",
      "properties": {
        "failure": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ItemKind"
        },
        "memory_sources": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/MemorySource"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Sources"
        },
        "ordinal": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ordinal"
        },
        "response_group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Group"
        },
        "state": {
          "$ref": "#/$defs/ItemState"
        }
      },
      "required": [
        "id",
        "kind",
        "state"
      ],
      "title": "ItemRef",
      "type": "object"
    },
    "ItemState": {
      "enum": [
        "in_progress",
        "completed",
        "interrupted",
        "failed"
      ],
      "type": "string"
    },
    "JsonValue": {},
    "MemorySource": {
      "additionalProperties": false,
      "description": "One automatic delivery in this Run; content remains in the memory or execution archive.",
      "properties": {
        "cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cursor"
        },
        "files": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FileSource"
          },
          "title": "Files",
          "type": "array"
        },
        "kind": {
          "enum": [
            "record",
            "file"
          ],
          "title": "Kind",
          "type": "string"
        },
        "memory": {
          "title": "Memory",
          "type": "string"
        },
        "memory_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Id"
        },
        "records": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RecordSource"
          },
          "title": "Records",
          "type": "array"
        },
        "sources_truncated": {
          "default": false,
          "title": "Sources Truncated",
          "type": "boolean"
        },
        "status": {
          "enum": [
            "recalled",
            "failed",
            "timeout",
            "full",
            "changes",
            "unchanged",
            "omitted",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "memory",
        "status"
      ],
      "title": "MemorySource",
      "type": "object"
    },
    "RecordSource": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "sha256"
      ],
      "title": "RecordSource",
      "type": "object"
    },
    "RunSignal": {
      "description": "The payload of `reset` and `gap`.",
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id"
      ],
      "title": "RunSignal",
      "type": "object"
    }
  },
  "frames": {
    "boundary": {
      "$ref": "#/$defs/Boundary"
    },
    "changed": {
      "$ref": "#/$defs/Changed"
    },
    "delta": {
      "$ref": "#/$defs/Delta"
    },
    "gap": {
      "$ref": "#/$defs/Gap"
    },
    "reset": {
      "$ref": "#/$defs/RunSignal"
    }
  },
  "title": "Thread stream frames"
}
