+    def list_page(self, filters: dict, top_k: int = 100, after_id: Optional[str] = None):
+        """Read one stable UUID-ordered page; never materialize the collection."""
+        if not 1 <= top_k <= 100:
+            raise ValueError("top_k must be between 1 and 100")
+        if not filters or not any(key in filters for key in ("user_id", "agent_id", "run_id")):
+            raise ValueError("A scoped page requires an entity filter")
+        self._ensure_collection()
+        conditions, params = _build_filter_conditions(filters)
+        if after_id is not None:
+            conditions.append("id > %s::uuid")
+            params.append(after_id)
+        query = sql.SQL("SELECT id, payload FROM {} WHERE {} ORDER BY id ASC LIMIT %s").format(
+            self._col(), sql.SQL(" AND ".join(conditions))
+        )
+        params.append(top_k + 1)
+        with self._get_cursor() as cur:
+            cur.execute(query, params)
+            rows = cur.fetchall()
+        more = len(rows) > top_k
+        page = rows[:top_k]
+        return (
+            [OutputData(id=str(row[0]), score=None, payload=row[1]) for row in page],
+            str(page[-1][0]) if more else None,
+        )
+
