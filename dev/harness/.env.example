# Harness SDK development: cp dev/harness/.env.example dev/harness/.env
# Loaded explicitly by make harness-dev; the Harness SDK never loads dotenv.
# Defaults match make langfuse-up with dev/service/local.toml (public test keys).
A13N_HARNESS_TRACE_LEVEL=verbose
A13N_HARNESS_TRACE_CONTENT=standard
A13N_HARNESS_METRICS=off
OTEL_SERVICE_NAME=a13n-harness-dev
# Deployment label in trace backends, not the Harness execution Environment.
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:3000/api/public/otel
OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic%20bGZfcGtfYWdlbnRfZm91bmRhdGlvbl9sb2NhbDpsZl9za19hZ2VudF9mb3VuZGF0aW9uX2xvY2Fs,x-langfuse-ingestion-version=4"
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_BSP_SCHEDULE_DELAY=500
OTEL_EXPORTER_OTLP_TIMEOUT=5
NO_PROXY=127.0.0.1,localhost,::1
no_proxy=127.0.0.1,localhost,::1
LANGFUSE_BASE_URL=http://127.0.0.1:3000

# Logfire alternative: REPLACE the two active OTLP endpoint/header lines above.
# Use a write token created in your Logfire project; keep it only in private .env.
# No Langfuse server or Logfire SDK is required for this standard OTLP profile.
# The EU endpoint is https://logfire-eu.pydantic.dev.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://logfire-us.pydantic.dev
# OTEL_EXPORTER_OTLP_HEADERS="Authorization=YOUR_LOGFIRE_WRITE_TOKEN"
# For real data, review the content policy before export; `none` omits normal
# execution payloads but is not a complete upstream exception/schema scrubber.
# A13N_HARNESS_TRACE_CONTENT=none
